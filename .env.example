# ─── UHQ Analytics Addon — Variables d'environnement ──────────────────────────
# Copier ce fichier en .env et ajuster les valeurs.

# Port du microservice (par défaut : 3001)
PORT=3001

# URL du panel UHQ — toutes les statistiques sont lues depuis son API
# (/api/panel/analytics/*) avec le JWT de l'utilisateur connecté.
PANEL_URL=http://localhost:8000

# Durée (secondes) de mise en cache des réponses du panel (défaut : 20).
# Les requêtes identiques d'un même utilisateur dans ce délai sont mutualisées.
CACHE_TTL_SECONDS=20

# Environnement (development | production)
NODE_ENV=development
